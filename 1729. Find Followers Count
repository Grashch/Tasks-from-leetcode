Pandas query:
import pandas as pd

def count_followers(followers: pd.DataFrame) -> pd.DataFrame:
    return followers.groupby('user_id', as_index=False)\
    .count()\
    .sort_values('user_id')\
    .rename(columns={'follower_id':'followers_count'})

