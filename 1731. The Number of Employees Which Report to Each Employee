SQL query:
-- Создаем таблицу сотрудников, если она еще не существует
Create table If Not Exists Employees1(
	employee_id int, 
	name varchar(20), 
	reports_to int, age int)

-- Заполняем таблицу данными: ID, имя, ID начальника и возраст
insert into Employees1 (employee_id, name, reports_to, age) values 
('9', 'Hercy', NULL, '43'),
('6', 'Alice', '9', '41'),
('4', 'Bob', '9', '36'),
('2', 'Winston', NULL, '37')

-- Выбираем данные начальника и считаем метрики для его подчиненных
select 
	e.employee_id, -- ID менеджера
	e.name, -- Имя менеджера
	count(e2.employee_id) as reports_count, -- Подсчитываем количество прямых подчиненных
	AVG(round(e2.age ,1)) -- Вычисляем средний возраст подчиненных с округлением
-- Соединяем таблицу саму с собой: слева менеджер (e), справа — его подчиненные (e2)
from employees1 e join employees1 e2 
on e.employee_id = e2.reports_to -- Условие: ID менеджера совпадает с полем reports_to у сотрудника
group by e.employee_id, e.name -- Группируем результаты по каждому конкретному менеджеру


Pandas query:
import pandas as pd

data = [[9, 'Hercy', None, 43], [6, 'Alice', 9, 41], [4, 'Bob', 9, 36], [2, 'Winston', None, 37]]
employees = pd.DataFrame(data, columns=['employee_id', 'name', 'reports_to', 'age']).astype
		(
        {'employee_id':'Int64', 'name':'object', 'reports_to':'Int64', 'age':'Int64'}
        )

def count_employees(employees: pd.DataFrame) -> pd.DataFrame:
    # Группируем по начальникам и считаем число подчиненных и средний возраст
    temp = employees.groupby('reports_to').agg(
        reports_count = ('employee_id', 'count'),
        average_age = ('age', 'mean') 
    ).reset_index()

    # Применяем математическое округление (0.5 вверх) и приводим к целому числу
    temp['average_age'] = (temp['average_age'] + 0.5).astype(int)
    
    # Подтягиваем имена начальников по их ID из исходной таблицы
    result = temp.merge(employees[['employee_id', 'name']],
                        left_on='reports_to',
                        right_on='employee_id')
    
    # Возвращаем итоговый набор колонок в нужном порядке
    return result[['employee_id', 'name', 'reports_count', 'average_age']]
